<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GARbro.Desktop.MainWindow"
        Width="1280" Height="760" MinWidth="900" MinHeight="540"
        Title="GARbro">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
    <Border Grid.Row="0" Padding="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Click="Back_Click" ToolTip.Tip="Back">Back</Button>
        <TextBox Grid.Column="1" Text="{Binding PathText, Mode=TwoWay}" PlaceholderText="Folder or archive path" />
        <Button Grid.Column="2" Click="OpenPath_Click">Open</Button>
        <Button Grid.Column="3" Click="Extract_Click" IsEnabled="{Binding HasArchive}">Extract selected</Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*,380" ColumnSpacing="0">
      <Border Grid.Column="0" Padding="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
        <StackPanel Spacing="10">
          <TextBlock Text="Locations" FontWeight="SemiBold" />
          <Button HorizontalAlignment="Stretch" Click="Home_Click">Home</Button>
          <Button HorizontalAlignment="Stretch" Click="WorkingFolder_Click">Working folder</Button>
          <TextBlock Text="Archive navigation and recent locations will appear here." TextWrapping="Wrap" Opacity="0.65" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="12,10" Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}">
            <Grid ColumnDefinitions="*,110,100">
              <TextBlock Text="Name" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" DoubleTapped="Entry_DoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12,8">
                  <Grid ColumnDefinitions="*,110,100">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Type}" Opacity="0.7" />
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" Opacity="0.7" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Padding="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <TextBlock Text="Preview" FontWeight="SemiBold" />
          <Grid Grid.Row="1">
            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" IsVisible="{Binding HasPreviewImage}" />
            <TextBox Text="{Binding PreviewText}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" IsVisible="{Binding HasPreviewText}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="12,8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
